{
  "name": "mediashell",
  "version": "2.2.0",
  "private": true,
  "description": "A GNOME extension that adds configurable MPRIS media controls to the top bar.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "check": "node scripts/dev.mjs check",
    "check:all": "node scripts/dev.mjs check all",
    "check:package": "node scripts/dev.mjs check package",
    "check:shexli": "node scripts/dev.mjs check shexli",
    "test": "node scripts/dev.mjs test",
    "lint": "node scripts/dev.mjs lint",
    "format": "prettier --write .",
    "build:debug": "node scripts/dev.mjs build debug",
    "build:release": "node scripts/dev.mjs build release",
    "build:force": "node scripts/dev.mjs build force",
    "ext:install": "node scripts/dev.mjs ext install",
    "ext:remove": "node scripts/dev.mjs ext remove",
    "ext:enable": "node scripts/dev.mjs ext enable",
    "ext:disable": "node scripts/dev.mjs ext disable",
    "ext:prefs": "node scripts/dev.mjs ext prefs",
    "ext:reinstall": "node scripts/dev.mjs ext reinstall",
    "ext:upload": "node scripts/dev.mjs ext upload",
    "env:doctor": "node scripts/dev.mjs env doctor",
    "shell:debug": "node scripts/dev.mjs shell debug",
    "translations": "node scripts/dev.mjs translations"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "prettier": "^3.9.6"
  }
}
