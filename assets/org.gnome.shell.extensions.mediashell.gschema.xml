<?xml version="1.0" encoding="UTF-8"?>
<schemalist>

  <enum id="org.gnome.shell.extensions.mediashell.input-actions">
    <value nick="none"             value="0"  />
    <value nick="toggle-shuffle"   value="1"  />
    <value nick="previous-track"   value="2"  />
    <value nick="play-pause"       value="3"  />
    <value nick="next-track"       value="4"  />
    <value nick="toggle-loop"      value="5"  />
    <value nick="volume-up"        value="6"  />
    <value nick="volume-down"      value="7"  />
    <value nick="toggle-popup"     value="8"  />
    <value nick="open-preferences" value="9"  />
    <value nick="raise-app"        value="10" />
    <value nick="quit-app"         value="11" />
    <value nick="switch-app"       value="12" />
    <value nick="seek-backward"    value="13" />
    <value nick="seek-forward"     value="14" />
  </enum>

  <enum id="org.gnome.shell.extensions.mediashell.panel-positions">
    <value nick="left"   value="0" />
    <value nick="center" value="1" />
    <value nick="right"  value="2" />
  </enum>

  <enum id="org.gnome.shell.extensions.mediashell.visualizer-styles">
    <value nick="beats"    value="0" />
    <value nick="pulse"    value="1" />
    <value nick="classic"  value="2" />
    <value nick="spectrum" value="3" />
    <value nick="vinyl"    value="4" />
  </enum>

  <schema id="org.gnome.shell.extensions.mediashell"
          path="/org/gnome/shell/extensions/mediashell/">

    <!-- Popup -->
    <key name="popup-width" type="u">
      <range min="250" max="500" />
      <default>250</default>
    </key>
    <key name="popup-artwork-show" type="b">
      <default>true</default>
    </key>
    <key name="popup-artwork-corner-radius-percent" type="u">
      <range min="0" max="100" />
      <default>20</default>
    </key>
    <key name="popup-track-information-show" type="b">
      <default>true</default>
    </key>
    <key name="popup-track-information-content" type="as">
      <default>['title', 'artist', 'album']</default>
    </key>
    <key name="popup-progress-bar-show" type="b">
      <default>true</default>
    </key>
    <key name="popup-playback-controls-show" type="b">
      <default>true</default>
    </key>
    <key name="popup-playback-controls-shuffle-show" type="b">
      <default>true</default>
    </key>
    <key name="popup-playback-controls-seek-backward-show" type="b">
      <default>false</default>
    </key>
    <key name="popup-playback-controls-previous-track-show" type="b">
      <default>true</default>
    </key>
    <key name="popup-playback-controls-play-pause-show" type="b">
      <default>true</default>
    </key>
    <key name="popup-playback-controls-next-track-show" type="b">
      <default>true</default>
    </key>
    <key name="popup-playback-controls-seek-forward-show" type="b">
      <default>false</default>
    </key>
    <key name="popup-playback-controls-repeat-show" type="b">
      <default>true</default>
    </key>
    <key name="popup-playback-controls-speed-show" type="b">
      <default>false</default>
    </key>
    <key name="popup-volume-control-show" type="b">
      <default>false</default>
    </key>
    <key name="popup-track-information-scroll-enabled" type="b">
      <default>false</default>
    </key>
    <key name="popup-track-information-scroll-speed" type="u">
      <range min="1" max="10" />
      <default>4</default>
    </key>
    <key name="popup-track-information-scroll-pause-seconds" type="u">
      <range min="0" max="10" />
      <default>1</default>
    </key>
    <key name="popup-player-selector-app-icon-use-color" type="b">
      <default>true</default>
    </key>

    <!-- Top bar -->
    <key name="top-bar-track-information-show" type="b">
      <default>true</default>
    </key>
    <key name="top-bar-track-information-width" type="u">
      <range min="0" max="1000" />
      <default>200</default>
    </key>
    <key name="top-bar-track-information-fixed-width" type="b">
      <default>false</default>
    </key>
    <key name="top-bar-track-information-scroll-enabled" type="b">
      <default>false</default>
    </key>
    <key name="top-bar-track-information-scroll-speed" type="u">
      <range min="1" max="10" />
      <default>4</default>
    </key>
    <key name="top-bar-track-information-scroll-pause-seconds" type="u">
      <range min="0" max="10" />
      <default>1</default>
    </key>
    <key name="top-bar-track-information-content" type="as">
      <default>['title', '•', 'artist']</default>
    </key>
    <key name="top-bar-app-icon-show" type="b">
      <default>true</default>
    </key>
    <key name="top-bar-app-icon-use-color" type="b">
      <default>false</default>
    </key>
    <key name="top-bar-artwork-show" type="b">
      <default>false</default>
    </key>
    <key name="top-bar-artwork-corner-radius-percent" type="u">
      <range min="0" max="100" />
      <default>40</default>
    </key>
    <key name="top-bar-visualizer-show" type="b">
      <default>false</default>
    </key>
    <key name="top-bar-visualizer-style"
         enum="org.gnome.shell.extensions.mediashell.visualizer-styles">
      <default>'beats'</default>
    </key>
    <key name="top-bar-visualizer-speed" type="u">
      <range min="1" max="8" />
      <default>4</default>
    </key>
    <key name="top-bar-playback-controls-show" type="b">
      <default>true</default>
    </key>
    <key name="top-bar-playback-controls-shuffle-show" type="b">
      <default>false</default>
    </key>
    <key name="top-bar-playback-controls-seek-backward-show" type="b">
      <default>false</default>
    </key>
    <key name="top-bar-playback-controls-previous-track-show" type="b">
      <default>true</default>
    </key>
    <key name="top-bar-playback-controls-play-pause-show" type="b">
      <default>true</default>
    </key>
    <key name="top-bar-playback-controls-next-track-show" type="b">
      <default>true</default>
    </key>
    <key name="top-bar-playback-controls-seek-forward-show" type="b">
      <default>false</default>
    </key>
    <key name="top-bar-playback-controls-repeat-show" type="b">
      <default>false</default>
    </key>
    <key name="top-bar-element-order" type="as">
      <default>['app-icon', 'artwork', 'track-information', 'visualizer', 'playback-controls']</default>
    </key>

    <!-- Panel -->
    <key name="panel-position"
         enum="org.gnome.shell.extensions.mediashell.panel-positions">
      <default>'center'</default>
    </key>
    <key name="panel-index" type="u">
      <range min="0" max="100" />
      <default>0</default>
    </key>

    <!-- Interactions -->
    <key name="interactions-shortcut-toggle-shuffle" type="as">
      <default><![CDATA[['']]]></default>
    </key>
    <key name="interactions-shortcut-previous-track" type="as">
      <default><![CDATA[['']]]></default>
    </key>
    <key name="interactions-shortcut-play-pause" type="as">
      <default><![CDATA[['']]]></default>
    </key>
    <key name="interactions-shortcut-next-track" type="as">
      <default><![CDATA[['']]]></default>
    </key>
    <key name="interactions-shortcut-toggle-loop" type="as">
      <default><![CDATA[['']]]></default>
    </key>
    <key name="interactions-shortcut-seek-backward" type="as">
      <default><![CDATA[['']]]></default>
    </key>
    <key name="interactions-shortcut-seek-forward" type="as">
      <default><![CDATA[['']]]></default>
    </key>
    <key name="interactions-shortcut-volume-up" type="as">
      <default><![CDATA[['']]]></default>
    </key>
    <key name="interactions-shortcut-volume-down" type="as">
      <default><![CDATA[['']]]></default>
    </key>
    <key name="interactions-shortcut-toggle-popup" type="as">
      <default><![CDATA[['']]]></default>
    </key>
    <key name="interactions-shortcut-open-preferences" type="as">
      <default><![CDATA[['']]]></default>
    </key>
    <key name="interactions-shortcut-raise-app" type="as">
      <default><![CDATA[['']]]></default>
    </key>
    <key name="interactions-shortcut-quit-app" type="as">
      <default><![CDATA[['']]]></default>
    </key>
    <key name="interactions-shortcut-switch-app" type="as">
      <default><![CDATA[['']]]></default>
    </key>
    <key name="interactions-mouse-action-left"
         enum="org.gnome.shell.extensions.mediashell.input-actions">
      <default>'toggle-popup'</default>
    </key>
    <key name="interactions-mouse-action-middle"
         enum="org.gnome.shell.extensions.mediashell.input-actions">
      <default>'open-preferences'</default>
    </key>
    <key name="interactions-mouse-action-right"
         enum="org.gnome.shell.extensions.mediashell.input-actions">
      <default>'raise-app'</default>
    </key>
    <key name="interactions-mouse-action-double"
         enum="org.gnome.shell.extensions.mediashell.input-actions">
      <default>'none'</default>
    </key>
    <key name="interactions-mouse-action-scroll-up"
         enum="org.gnome.shell.extensions.mediashell.input-actions">
      <default>'volume-up'</default>
    </key>
    <key name="interactions-mouse-action-scroll-down"
         enum="org.gnome.shell.extensions.mediashell.input-actions">
      <default>'volume-down'</default>
    </key>

    <!-- Others -->
    <key name="native-controls-hide" type="b">
      <default>true</default>
    </key>
    <key name="native-controls-enhance" type="b">
      <default>false</default>
    </key>
    <key name="media-artwork-cache-enabled" type="b">
      <default>true</default>
    </key>
    <key name="media-blocked-apps" type="as">
      <default>[]</default>
    </key>

  </schema>
</schemalist>
